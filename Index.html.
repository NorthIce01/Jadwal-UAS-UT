<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Jadwal Belajar UAS - Zahra Adnin Aurelia</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#F2F5F9;--surface:#FFFFFF;--ink:#1B2740;--mute:#5E6B82;--line:#D9E0EA;--accent:#0E7C86;--accent-ink:#FFFFFF;--today:#E8A900;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0F1626;--surface:#18223A;--ink:#E8EDF6;--mute:#9AA7BF;--line:#2A3754;--accent:#3CC4CF;--accent-ink:#06222A;--today:#E0B13F;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0F1626;--surface:#18223A;--ink:#E8EDF6;--mute:#9AA7BF;--line:#2A3754;--accent:#3CC4CF;--accent-ink:#06222A;--today:#E0B13F;color-scheme:dark}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 120px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 "Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:var(--bg);padding:14px 16px 12px;border-bottom:1px solid var(--line)}
.wrap{max-width:640px;margin:0 auto}
h1{font-size:22px;font-weight:800;margin:0;letter-spacing:-.01em}
.sub{color:var(--mute);font-size:14px;margin:2px 0 10px}
.bar{height:10px;border-radius:5px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .25s}
.count{display:flex;justify-content:space-between;font-size:14px;margin-top:6px;font-weight:600}
main{padding:16px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.chip{display:flex;align-items:center;gap:6px;font-size:13px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:3px 10px}
.dot{width:10px;height:10px;border-radius:50%;flex:none}
h2{font-size:15px;font-weight:800;margin:24px 0 8px;color:var(--mute)}
.day{background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-bottom:10px;overflow:hidden}
.day.today{border-color:var(--today);box-shadow:0 0 0 2px var(--today)}
.dh{display:flex;justify-content:space-between;align-items:baseline;padding:10px 14px 4px}
.dh b{font-size:16px;font-weight:800}
.dh span{font-size:13px;color:var(--mute)}
.badge{background:var(--today);color:#1B2740;border-radius:6px;padding:1px 8px;font-size:12px;font-weight:600;margin-left:8px}
.day.done .dh b{color:var(--accent)}
label.row{display:flex;align-items:center;gap:12px;padding:9px 14px;min-height:46px;cursor:pointer;border-top:1px solid var(--line)}
label.row:first-of-type{border-top:0}
input[type=checkbox]{appearance:none;-webkit-appearance:none;width:24px;height:24px;border:2px solid var(--mute);border-radius:7px;flex:none;margin:0;display:grid;place-content:center;cursor:pointer;background:transparent}
input[type=checkbox]:checked{background:var(--accent);border-color:var(--accent)}
input[type=checkbox]:checked::after{content:"";width:6px;height:11px;border:solid var(--accent-ink);border-width:0 2.5px 2.5px 0;transform:rotate(45deg) translate(-1px,-1px)}
input[type=checkbox]:focus-visible{outline:3px solid var(--today);outline-offset:2px}
.t{flex:1}
label.row:has(input:checked) .t{color:var(--mute);text-decoration:line-through}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:10px}
.card h3{margin:0 0 4px;font-size:16px;font-weight:800}
.card p{margin:0;color:var(--mute);font-size:14px}
.card ul{margin:6px 0 0;padding-left:20px}
.mod{border-top:1px solid var(--line)}
.dh+.mod{border-top:0}
.day>label.row{border-top:1px solid var(--line)}
.kids{padding:0 14px 8px 50px}
label.kid{display:flex;align-items:center;gap:10px;min-height:40px;cursor:pointer;font-size:15px;border-left:2px solid var(--line);padding-left:12px}
label.kid input{width:20px;height:20px;border-radius:6px}
label.kid:has(input:checked){color:var(--mute);text-decoration:line-through}
.kc{font-size:13px;color:var(--mute);margin-left:6px}
.tip{font-size:14px;color:var(--mute);margin:12px 0}
button{font:600 15px "Bricolage Grotesque",system-ui,sans-serif;border:1.5px solid var(--mute);background:transparent;color:var(--ink);border-radius:10px;padding:10px 16px;min-height:44px;cursor:pointer;margin-top:12px}
button:focus-visible{outline:3px solid var(--today);outline-offset:2px}
</style>
</head>
<body>
<header><div class="wrap">
<h1>Zahra Adnin Aurelia</h1>
<div class="sub">Jadwal belajar UAS UT 2026, 18 November sampai 4 Desember</div>
<div class="bar"><i id="fill"></i></div>
<div class="count"><span id="cnt">0 dari 51 modul selesai</span><span id="pct">0%</span></div>
</div></header>
<main><div class="wrap">
<div class="chips" id="chips"></div>
<div id="plan"></div>

<h2>Hari ujian</h2>
<div class="card"><h3>Sabtu, 5 Desember</h3><ul><li>Pengantar Ilmu Komunikasi</li><li>Pendidikan Pancasila</li><li>Kawasan Teknologi Pendidikan</li></ul></div>
<div class="card"><h3>Minggu, 6 Desember</h3><ul><li>Jaringan Komputer</li><li>Pendidikan Orang Dewasa</li><li>Pendidikan Agama Islam</li></ul></div>

<h2>Cara belajar setiap modul</h2>
<div class="card"><p>Satu modul punya 2 Kegiatan Belajar (KB). Di setiap KB: baca materi, catat konsep penting, lalu kerjakan 10 soal pilihan ganda dan 5 soal esai. Total satu modul: 20 pilihan ganda dan 10 esai.</p></div>
<div class="tip">Kalau satu modul panjang atau sulit, utamakan pemahaman. Tidak apa-apa menggeser modul ke hari berikutnya.</div>
<button id="reset" type="button">Hapus semua centang</button>
</div></main>
<script>
var C={ilkom:["Pengantar Ilmu Komunikasi",9,"#D1495B"],pancasila:["Pendidikan Pancasila",6,"#C98A00"],tpen:["Kawasan Teknologi Pendidikan",12,"#2E86DE"],jakom:["Jaringan Komputer",9,"#7B5CD6"],pod:["Pendidikan Orang Dewasa",6,"#2A9D6F"],agama:["Pendidikan Agama Islam",9,"#0E8A9A"]};
var W=[
["Minggu 1",[
["2026-11-18",[["ilkom",1,2],["pancasila",1]]],
["2026-11-19",[["ilkom",3,4],["pancasila",2]]],
["2026-11-20",[["ilkom",5],["pancasila",3],["tpen",1]]],
["2026-11-21",[["ilkom",6,7],["pancasila",4]]],
["2026-11-22",[["ilkom",8],["pancasila",5],["tpen",2]]],
["2026-11-23",[["ilkom",9],["pancasila",6],["agama",1]]],
["2026-11-24",[["tpen",3,4],["agama",2]]]]],
["Minggu 2",[
["2026-11-25",[["tpen",5,6],["jakom",1]]],
["2026-11-26",[["tpen",7,8],["jakom",2]]],
["2026-11-27",[["tpen",9,10],["pod",1]]],
["2026-11-28",[["tpen",11,12],["pod",2]]],
["2026-11-29",[["jakom",3,4],["pod",3]]],
["2026-11-30",[["jakom",5],["pod",4],["agama",3]]]]],
["Persiapan akhir",[
["2026-12-01",[["jakom",6,7],["pod",5]]],
["2026-12-02",[["jakom",8,9],["pod",6]]],
["2026-12-03",[["agama",4,5,6]]],
["2026-12-04",[["agama",7,8,9]],"Review ringan semua mata kuliah"]]]
];
var KEY="uas-ut-2026",S={};
try{S=JSON.parse(localStorage.getItem(KEY)||"{}")||{}}catch(e){S={}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
var BULAN=["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"];
var t=new Date(),todayKey=t.getFullYear()+"-"+String(t.getMonth()+1).padStart(2,"0")+"-"+String(t.getDate()).padStart(2,"0");
var plan=document.getElementById("plan"),html="";
W.forEach(function(w){
 html+="<h2>"+w[0]+"</h2>";
 w[1].forEach(function(d){
  var p=d[0].split("-"),dt=new Date(+p[0],+p[1]-1,+p[2]);
  var hari=dt.toLocaleDateString("id-ID",{weekday:"long"});
  html+='<section class="day'+(d[0]===todayKey?" today":"")+'" data-day="'+d[0]+'"><div class="dh"><div><b>'+(+p[2])+" "+BULAN[+p[1]-1]+"</b>"+(d[0]===todayKey?'<span class="badge">Hari ini</span>':"")+'</div><span class="dc"></span></div>';
  d[1].forEach(function(c){
   for(var i=1;i<c.length;i++){
    var id=c[0]+"-"+c[i];
    html+='<div class="mod"><label class="row"><input type="checkbox" data-id="'+id+'" data-m="1"><span class="dot" style="background:'+C[c[0]][2]+'"></span><span class="t">'+C[c[0]][0]+" Modul "+c[i]+'</span><span class="kc" data-kc="'+id+'"></span></label><div class="kids"><label class="kid"><input type="checkbox" data-k="1" data-p="'+id+'" data-id="'+id+'-kb1"><span class="t">Kegiatan Belajar 1</span></label><label class="kid"><input type="checkbox" data-k="1" data-p="'+id+'" data-id="'+id+'-kb2"><span class="t">Kegiatan Belajar 2</span></label></div></div>';
   }
  });
  if(d[2]){html+='<label class="row"><input type="checkbox" data-id="review-'+d[0]+'"><span class="dot" style="background:var(--mute)"></span><span class="t">'+d[2]+"</span></label>"}
  html+="</section>";
  html=html.replace('<span class="dc"></span>','<span class="dc">'+hari+"</span>");
 });
});
plan.innerHTML=html;
var chips=document.getElementById("chips"),ch="";
Object.keys(C).forEach(function(k){ch+='<span class="chip"><span class="dot" style="background:'+C[k][2]+'"></span>'+C[k][0]+' <b data-c="'+k+'">0/'+C[k][1]+"</b></span>"});
chips.innerHTML=ch;
var boxes=[].slice.call(document.querySelectorAll("input[type=checkbox]"));
function update(){
 var done=0;
 boxes.forEach(function(b){b.checked=!!S[b.dataset.id];if(b.dataset.m&&b.checked)done++});
 document.querySelectorAll("[data-kc]").forEach(function(e){var id=e.dataset.kc,n=(S[id+"-kb1"]?1:0)+(S[id+"-kb2"]?1:0);e.textContent="("+n+"/2)"});
 document.querySelectorAll(".day").forEach(function(s){
  var bs=s.querySelectorAll("input:not([data-k])"),n=0;
  bs.forEach(function(b){if(b.checked)n++});
  var hari=s.querySelector(".dc").textContent.replace(/ \(.*/,"");
  s.querySelector(".dc").textContent=hari+" ("+n+"/"+bs.length+")";
  s.classList.toggle("done",n===bs.length);
 });
 Object.keys(C).forEach(function(k){
  var n=0;boxes.forEach(function(b){if(b.dataset.m&&b.dataset.id.indexOf(k+"-")===0&&b.checked)n++});
  document.querySelector('[data-c="'+k+'"]').textContent=n+"/"+C[k][1];
 });
 var pct=Math.round(done/51*100);
 document.getElementById("fill").style.width=pct+"%";
 document.getElementById("cnt").textContent=done+" dari 51 modul selesai";
 document.getElementById("pct").textContent=pct+"%";
}
boxes.forEach(function(b){if(b.dataset.m){var id=b.dataset.id;if(S[id]&&!S[id+"-kb1"]&&!S[id+"-kb2"]){S[id+"-kb1"]=1;S[id+"-kb2"]=1}}});
function setv(id,v){if(v)S[id]=1;else delete S[id]}
boxes.forEach(function(b){b.addEventListener("change",function(){
 var id=b.dataset.id;setv(id,b.checked);
 if(b.dataset.m){setv(id+"-kb1",b.checked);setv(id+"-kb2",b.checked)}
 if(b.dataset.k){var p=b.dataset.p;setv(p,S[p+"-kb1"]&&S[p+"-kb2"])}
 save();update()})});
var rb=document.getElementById("reset"),rt;
rb.addEventListener("click",function(){
 if(rb.dataset.arm){S={};save();update();rb.textContent="Hapus semua centang";delete rb.dataset.arm;clearTimeout(rt);return}
 rb.dataset.arm=1;rb.textContent="Yakin? Ketuk sekali lagi";
 rt=setTimeout(function(){delete rb.dataset.arm;rb.textContent="Hapus semua centang"},3000);
});
update();
var td=document.querySelector(".day.today");if(td){setTimeout(function(){td.scrollIntoView({block:"start"})},50)}
</script>
</body>
</html>
